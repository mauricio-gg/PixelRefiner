{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/browser/guide.ts",
        "src/**/*.test.ts",
        "test/**/*.test.ts",
        "test/quality/quality-reporter.ts",
        "scripts/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["prettier", "repomix"]
    },
    "packages/mcp": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "tsdown.config.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["@modelcontextprotocol/server", "@modelcontextprotocol/client", "sharp", "zod"]
    }
  },
  "ignoreIssues": {
    "test/quality/**": ["exports", "types"],
    "src/shared/option-values.ts": ["exports"]
  }
}
