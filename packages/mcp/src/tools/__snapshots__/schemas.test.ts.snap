      "enum": [
        "summary",
        "full",
      ],
      "type": "string",
    },
    "input": {
      "description": "Absolute path to the image file. Relative paths are rejected because this process's working directory is not yours.",
      "type": "string",
    },
    "output": {
      "description": "Absolute .png path to write; defaults to <stem>.refined.png next to the input.",
      "type": "string",
    },
    "overwrite": {
      "default": false,
      "description": "Allow replacing an existing output file.",
      "type": "boolean",
    },
    "preview": {
      "default": true,
      "description": "Return the result as an image block scaled to about 512px.",
      "type": "boolean",
    },
    "scale": {
      "default": 1,
